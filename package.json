    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.3.0",
    "@nuxt/icon": "^1.12.0",
    "@pinia/nuxt": "^0.11.0",
    "@types/uuid": "^10.0.0",
    "@unocss/core": "^66.0.0",
    "@unocss/nuxt": "^66.0.0",
    "@vueuse/core": "^13.1.0",
    "@vueuse/nuxt": "^13.1.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.43.1",
    "nuxt": "^3.17.1",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "postgres": "^3.4.5",
    "unocss": "^66.0.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
